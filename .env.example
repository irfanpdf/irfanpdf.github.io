# Required before publishing: your real public domain, no trailing slash.
# Without it the site still builds, but canonical URLs, Open Graph URLs,
# sitemap.xml and robots.txt are OMITTED rather than filled with guesses.
NEXT_PUBLIC_SITE_URL=

# Optional: where the real installer/ZIP files will live once hosted
# (for example https://downloads.example.com/irfan-pdf).
# Without it the Download Center shows the verified package metadata
# (version, size, SHA-256) with download buttons in a "link not configured"
# state - it never links to a guessed URL.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=
